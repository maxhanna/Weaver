<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- True single-file: package native libraries (e_sqlite3, tree-sitter) and
         content files are bundled INSIDE Weaver.exe and extracted at runtime,
         so the exe works when copied alone to a fresh folder. Without this the
         native DLLs land beside the exe and a lone copy throws DllNotFoundException
         (Microsoft.Data.Sqlite type initializer). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <ApplicationIcon>WeaverIcon.ico</ApplicationIcon>
    <!-- Tests live in tests/Weaver.Tests.csproj (run with `dotnet test
         tests/Weaver.Tests.csproj`). This assembly is the shipped app only.
         NOTE: raw <InternalsVisibleTo> is an ItemGroup element — the ItemGroup
         form requires a .NET 10 MSBuild; a plain SDK ItemGroup works on the
         shipping 10 SDK too, but the explicit attribute file is the most
         portable form and reads the same. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Test sources stay out of this project entirely (they used to be globbed in).
         The js/ test helper and corpus JSON also stay out of content and
         embedded-resource globs. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The xunit suites reach internal statics directly (e.g. the CodeFormatterService
         test seam); they now compile into a separate Weaver.Tests assembly. -->
    <InternalsVisibleTo Include="Weaver.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*.*" />
    <!-- appsettings.json is bundled into the single-file exe; Program.cs loads it
         from this embedded copy when the on-disk file is missing. -->
    <EmbeddedResource Include="appsettings.json" />
    <!-- Keep the local data/ folder (dev SQLite DB, VAPID keys) OUT of the publish
         output and out of the bundle — those are per-install runtime files. -->
    <Content Remove="data\**" />
    <None Remove="data\**" />
    <EmbeddedResource Remove="data\**" />
  </ItemGroup> 

  <ItemGroup>
    <PackageReference Include="AngleSharp.Css" Version="0.18.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <Target Name="ExecuteJsLint" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Preparing C# Script Environment for JS evaluation..." />
    <!-- Install only when missing — `dotnet tool install` is a slow network/disk op
         that was previously run on EVERY build (and therefore every test run). -->
    <Exec Command="dotnet tool install --global dotnet-script"
          Condition="!Exists('$(UserProfile)\.dotnet\tools\dotnet-script.exe')"
          ContinueOnError="true" StandardOutputImportance="low" />
    <Exec Command="dotnet-script lint.csx" ContinueOnError="false" />
  </Target>

</Project>
